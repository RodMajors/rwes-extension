{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extensionName__",
  "short_name": "__MSG_extensionShortName__",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "111",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": ["https://wowdata.rodmajors.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "__MSG_extensionName__" },
  "content_scripts": [
    { "matches": [], "js": ["content.js"], "run_at": "document_start" },
    { "matches": [], "js": ["page-hooks-main.js"], "run_at": "document_start", "world": "MAIN" }
  ]
}
